digraph "riscv::Memory"
{
 // LATEX_PDF_SIZE
  bgcolor="transparent";
  edge [fontname=Helvetica,fontsize=10,labelfontname=Helvetica,labelfontsize=10];
  node [fontname=Helvetica,fontsize=10,shape=box,height=0.2,width=0.4];
  rankdir="LR";
  Node1 [id="Node000001",label="riscv::Memory",height=0.2,width=0.4,color="gray40", fillcolor="grey60", style="filled", fontcolor="black",tooltip="Abstract interface for all memory-mapped entities."];
  Node1 -> Node2 [id="edge1_Node000001_Node000002",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node2 [id="Node000002",label="riscv::Cache",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classriscv_1_1Cache.html",tooltip="Single cache level with configurable geometry, replacement, and write policies."];
  Node1 -> Node3 [id="edge2_Node000001_Node000003",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node3 [id="Node000003",label="riscv::CacheHierarchy",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classriscv_1_1CacheHierarchy.html",tooltip="Multi-level cache chain backed by a main memory."];
  Node1 -> Node4 [id="edge3_Node000001_Node000004",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node4 [id="Node000004",label="riscv::FlatMemory",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classriscv_1_1FlatMemory.html",tooltip="Contiguous, byte-addressable RAM region."];
  Node1 -> Node5 [id="edge4_Node000001_Node000005",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node5 [id="Node000005",label="riscv::MMIOBus",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classriscv_1_1MMIOBus.html",tooltip="Address-space router connecting the CPU to memory-mapped devices."];
  Node1 -> Node6 [id="edge5_Node000001_Node000006",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node6 [id="Node000006",label="riscv::NIC",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classriscv_1_1NIC.html",tooltip="Cycle-accurate network interface controller."];
  Node1 -> Node7 [id="edge6_Node000001_Node000007",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node7 [id="Node000007",label="riscv::PLIC",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classriscv_1_1PLIC.html",tooltip="MMIO-mapped Platform-Level Interrupt Controller."];
  Node1 -> Node8 [id="edge7_Node000001_Node000008",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node8 [id="Node000008",label="riscv::Timer",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classriscv_1_1Timer.html",tooltip="CLINT machine-mode timer."];
