digraph "riscv::CPU"
{
 // LATEX_PDF_SIZE
  bgcolor="transparent";
  edge [fontname=Helvetica,fontsize=10,labelfontname=Helvetica,labelfontsize=10];
  node [fontname=Helvetica,fontsize=10,shape=box,height=0.2,width=0.4];
  Node1 [id="Node000001",label="riscv::CPU",height=0.2,width=0.4,color="gray40", fillcolor="grey60", style="filled", fontcolor="black",tooltip="Single-cycle RISC-V CPU implementing fetch-decode-execute."];
  Node2 -> Node1 [id="edge1_Node000001_Node000002",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" executor_",fontcolor="grey" ];
  Node2 [id="Node000002",label="riscv::Executor",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classriscv_1_1Executor.html",tooltip="Instruction executor maintaining hart architectural state."];
  Node3 -> Node2 [id="edge2_Node000002_Node000003",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" memory_",fontcolor="grey" ];
  Node3 [id="Node000003",label="riscv::Memory",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classriscv_1_1Memory.html",tooltip="Abstract interface for all memory-mapped entities."];
  Node4 -> Node2 [id="edge3_Node000002_Node000004",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" stats_",fontcolor="grey" ];
  Node4 [id="Node000004",label="riscv::CpuStats",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structriscv_1_1CpuStats.html",tooltip="Performance and telemetry counters."];
  Node5 -> Node2 [id="edge4_Node000002_Node000005",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" vstate_",fontcolor="grey" ];
  Node5 [id="Node000005",label="riscv::VectorState",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structriscv_1_1VectorState.html",tooltip="Complete vector extension state: registers, vtype CSR, and vector length."];
  Node6 -> Node5 [id="edge5_Node000005_Node000006",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" regs",fontcolor="grey" ];
  Node6 [id="Node000006",label="riscv::VectorRegFile",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classriscv_1_1VectorRegFile.html",tooltip="Managed storage for the 32 vector registers (v0-v31)."];
  Node7 -> Node6 [id="edge6_Node000006_Node000007",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" config_",fontcolor="grey" ];
  Node7 [id="Node000007",label="riscv::VectorConfig",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structriscv_1_1VectorConfig.html",tooltip="Hardware configuration parameters for the vector unit."];
  Node8 -> Node5 [id="edge7_Node000005_Node000008",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" vtype",fontcolor="grey" ];
  Node8 [id="Node000008",label="riscv::VType",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structriscv_1_1VType.html",tooltip="Represents the vtype CSR."];
  Node9 -> Node2 [id="edge8_Node000002_Node000009",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" csrs_",fontcolor="grey" ];
  Node9 [id="Node000009",label="riscv::CSRFile",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classriscv_1_1CSRFile.html",tooltip="Container for machine-mode CSR state."];
  Node10 -> Node1 [id="edge9_Node000001_Node000010",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" last_inst_",fontcolor="grey" ];
  Node10 [id="Node000010",label="riscv::DecodedInst",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structriscv_1_1DecodedInst.html",tooltip="Fully decoded representation of a single instruction."];
  Node11 -> Node1 [id="edge10_Node000001_Node000011",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" last_result_",fontcolor="grey" ];
  Node11 [id="Node000011",label="riscv::ExecuteResult",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structriscv_1_1ExecuteResult.html",tooltip="Result returned by the executor after processing one instruction."];
}
